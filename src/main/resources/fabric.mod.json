{
  "schemaVersion": 1,
  "id": "discord-addon",
  "version": "${version}",
  "name": "Discord Addon",
  "description": "Discord addon acts as a bridge between your Minecraft chat and Discord server.",
  "authors": [
    "QrystalGG"
  ],
  "contact": {
    "repo": "https://github.com/ItsQrystal/DiscordAddon"
  },
  "icon": "assets/discord-addon/icon.png",
  "environment": "client",
